      "transcript": [
        {
          "speaker": "Rahul Sharma",
          "start": 0.0,
          "end": 6.0,
          "text": "Our enterprise customers are asking for secure Azure AI solutions."
        },
        {
          "speaker": "AccountPilot AE",
          "start": 6.1,
          "end": 12.5,
          "text": "Which workloads are you planning to migrate?"
        },
        {
          "speaker": "Priya Nair",
          "start": 12.6,
          "end": 20.2,
          "text": "We are evaluating Azure OpenAI, Azure AI Studio and Azure Kubernetes Service."
        },
        {
          "speaker": "Rahul Sharma",
          "start": 20.3,
          "end": 29.1,
          "text": "Security, governance and compliance are our highest priorities."
        },
        {
          "speaker": "AccountPilot AE",
          "start": 29.2,
          "end": 37.8,
          "text": "We can demonstrate Azure Landing Zone, Cost Management and enterprise governance."
        },
        {
          "speaker": "Priya Nair",
          "start": 37.9,
          "end": 46.5,
          "text": "Please prepare a proof of concept with pricing estimates and migration timelines."
